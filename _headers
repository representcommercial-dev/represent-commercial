# Versioned shared assets — filename changes on every edit, so cache immutably.
/styles.v*.css
  Cache-Control: public, max-age=31536000, immutable
/nav.v*.js
  Cache-Control: public, max-age=31536000, immutable

# Legacy unversioned copies. Compatibility rule: keep these available while any
# previously cached HTML, or a supported rollback target, may still reference them.
# Retire only once no cached HTML can still be serving these URLs — judged from the
# HTML freshness window actually observed in staging, not from a release count.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/nav.js
  Cache-Control: public, max-age=0, must-revalidate

# Images — fixed filenames, so revalidate rather than claim immutability.
/*.webp
  Cache-Control: public, max-age=604800, must-revalidate
/*.jpg
  Cache-Control: public, max-age=604800, must-revalidate
/*.jpeg
  Cache-Control: public, max-age=604800, must-revalidate
/*.png
  Cache-Control: public, max-age=604800, must-revalidate
/*.svg
  Cache-Control: public, max-age=604800, must-revalidate

# HTML — always revalidate so a new release is picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
